{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Dubai Smart Property Explorer",
    "subtitle": "Dubai Sales | Units & Villas | Jan 2015 – Jul 2026 | Interactive analysis by location, time and property size",
    "fontSize": 26,
    "subtitleFontSize": 15,
    "anchor": "start"
  },
  "params": [
    {
      "name": "propertyFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Unit",
          "Villa"
        ],
        "labels": [
          "All types",
          "Units",
          "Villas"
        ],
        "name": "Property type: "
      }
    },
    {
      "name": "registrationFilter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "Existing Properties",
          "Off-Plan Properties"
        ],
        "labels": [
          "All registrations",
          "Existing",
          "Off-Plan"
        ],
        "name": "Registration: "
      }
    }
  ],
  "data": {
    "url": "https://raw.githubusercontent.com/sharios/CS333/main/2026-27/Part%202/transactions.csv",
    "format": {
      "type": "csv",
      "parse": {
        "instance_date": "date:'%Y-%m-%d'",
        "procedure_area": "number",
        "meter_sale_price": "number",
        "comm_num": "string"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.trans_group_en === 'Sales'"
    },
    {
      "filter": "datum.property_type_en === 'Unit' || datum.property_type_en === 'Villa'"
    },
    {
      "filter": "datum.reg_type_en === 'Existing Properties' || datum.reg_type_en === 'Off-Plan Properties'"
    },
    {
      "calculate": "datum.procedure_area",
      "as": "area_sqm"
    },
    {
      "calculate": "datum.meter_sale_price",
      "as": "price_sqm"
    },
    {
      "calculate": "datum.instance_date",
      "as": "transaction_date"
    },
    {
      "filter": "isValid(datum.area_sqm) && isValid(datum.price_sqm) && isFinite(datum.area_sqm) && isFinite(datum.price_sqm) && datum.area_sqm > 0 && datum.price_sqm > 0"
    },
    {
      "filter": "isValid(datum.transaction_date) && datum.transaction_date >= datetime(2015, 0, 1) && datum.transaction_date < datetime(2026, 7, 1)"
    },
    {
      "filter": "datum.area_sqm >= 20 && datum.area_sqm <= 1000 && datum.price_sqm >= 1000 && datum.price_sqm <= 60000"
    },
    {
      "filter": "propertyFilter === 'All' || datum.property_type_en === propertyFilter"
    },
    {
      "filter": "registrationFilter === 'All' || datum.reg_type_en === registrationFilter"
    }
  ],
  "vconcat": [
    {
      "hconcat": [
        {
          "title": {
            "text": "Where is it expensive? Median Price per m² by Community",
            "subtitle": "Click colored community to filter all views | Grey = insufficient / unmatched data | Double-click to reset"
          },
          "width": 520,
          "height": 400,
          "projection": {
            "type": "mercator"
          },
          "layer": [
            {
              "data": {
                "url": "https://raw.githubusercontent.com/sharios/CS333/main/2026-27/Part%202/dubai.geojson",
                "format": {
                  "type": "json",
                  "property": "features"
                }
              },
              "mark": {
                "type": "geoshape",
                "fill": "#e5e7eb",
                "stroke": "white",
                "strokeWidth": 0.5
              }
            },
            {
              "transform": [
                {
                  "filter": {
                    "param": "brush",
                    "empty": true
                  }
                },
                {
                  "filter": {
                    "param": "timeBrush",
                    "empty": true
                  }
                },
                {
                  "aggregate": [
                    {
                      "op": "median",
                      "field": "price_sqm",
                      "as": "median_price"
                    },
                    {
                      "op": "count",
                      "as": "transaction_count"
                    }
                  ],
                  "groupby": [
                    "comm_num"
                  ]
                },
                {
                  "filter": "datum.transaction_count >= 20"
                },
                {
                  "lookup": "comm_num",
                  "from": {
                    "data": {
                      "url": "https://raw.githubusercontent.com/sharios/CS333/main/2026-27/Part%202/dubai.geojson",
                      "format": {
                        "type": "json",
                        "property": "features"
                      }
                    },
                    "key": "properties.COMM_NUM"
                  },
                  "as": "geo"
                },
                {
                  "filter": "isValid(datum.geo)"
                },
                {
                  "calculate": "datum.geo.properties.CNAME_E",
                  "as": "community_name"
                }
              ],
              "params": [
                {
                  "name": "commSelect",
                  "select": {
                    "type": "point",
                    "fields": [
                      "comm_num"
                    ],
                    "on": "click",
                    "clear": "dblclick"
                  }
                }
              ],
              "mark": {
                "type": "geoshape",
                "stroke": "white",
                "cursor": "pointer"
              },
              "encoding": {
                "shape": {
                  "field": "geo",
                  "type": "geojson"
                },
                "color": {
                  "field": "median_price",
                  "type": "quantitative",
                  "title": "Median AED/m²",
                  "scale": {
                    "scheme": "yelloworangered",
                    "domain": [
                      1000,
                      60000
                    ],
                    "clamp": true
                  },
                  "legend": {
                    "orient": "bottom",
                    "format": ",.0f",
                    "gradientLength": 260
                  }
                },
                "strokeWidth": {
                  "condition": {
                    "param": "commSelect",
                    "empty": false,
                    "value": 2.5
                  },
                  "value": 0.5
                },
                "opacity": {
                  "condition": {
                    "param": "commSelect",
                    "value": 1
                  },
                  "value": 0.35
                },
                "tooltip": [
                  {
                    "field": "community_name",
                    "type": "nominal",
                    "title": "Community"
                  },
                  {
                    "field": "comm_num",
                    "type": "nominal",
                    "title": "Community no."
                  },
                  {
                    "field": "median_price",
                    "type": "quantitative",
                    "title": "Median AED/m²",
                    "format": ",.0f"
                  },
                  {
                    "field": "transaction_count",
                    "type": "quantitative",
                    "title": "Sales",
                    "format": ","
                  }
                ]
              }
            }
          ]
        },
        {
          "title": {
            "text": "Property Size vs Price per m²",
            "subtitle": "Display sample up to 5,000 sales | Drag to select a size range | Double-click to reset"
          },
          "width": 620,
          "height": 400,
          "transform": [
            {
              "filter": {
                "param": "commSelect",
                "empty": true
              }
            },
            {
              "filter": {
                "param": "timeBrush",
                "empty": true
              }
            },
            {
              "sample": 5000
            }
          ],
          "params": [
            {
              "name": "brush",
              "select": {
                "type": "interval",
                "encodings": [
                  "x"
                ],
                "clear": "dblclick",
                "on": "[pointerdown, window:pointerup] > window:pointermove{150}",
                "translate": false,
                "zoom": false
              }
            }
          ],
          "mark": {
            "type": "circle",
            "opacity": 0.35,
            "size": 40
          },
          "encoding": {
            "x": {
              "field": "area_sqm",
              "type": "quantitative",
              "title": "Property Area (m²)",
              "scale": {
                "domain": [
                  0,
                  1000
                ]
              }
            },
            "y": {
              "field": "price_sqm",
              "type": "quantitative",
              "title": "Price per m² (AED)",
              "scale": {
                "domain": [
                  0,
                  60000
                ]
              },
              "axis": {
                "format": ",.0f"
              }
            },
            "color": {
              "field": "reg_type_en",
              "type": "nominal",
              "title": "Registration Type",
              "scale": {
                "domain": [
                  "Existing Properties",
                  "Off-Plan Properties"
                ],
                "range": [
                  "#2563eb",
                  "#f97316"
                ]
              },
              "legend": {
                "orient": "top",
                "title": null
              }
            },
            "tooltip": [
              {
                "field": "area_name_en",
                "type": "nominal",
                "title": "Area"
              },
              {
                "field": "property_type_en",
                "type": "nominal",
                "title": "Property Type"
              },
              {
                "field": "rooms_en",
                "type": "nominal",
                "title": "Rooms"
              },
              {
                "field": "reg_type_en",
                "type": "nominal",
                "title": "Registration Type"
              },
              {
                "field": "transaction_date",
                "type": "temporal",
                "title": "Date",
                "format": "%d %b %Y"
              },
              {
                "field": "area_sqm",
                "type": "quantitative",
                "title": "Area (m²)",
                "format": ",.1f"
              },
              {
                "field": "price_sqm",
                "type": "quantitative",
                "title": "Price (AED/m²)",
                "format": ",.0f"
              }
            ]
          }
        }
      ],
      "spacing": 26
    },
    {
      "title": {
        "text": "When? Quarterly Median Price per m² — Existing vs Off-Plan",
        "subtitle": "Quarterly median AED/m² for Existing and Off-Plan | Drag to filter by date | Double-click to reset"
      },
      "width": 1180,
      "height": 230,
      "transform": [
        {
          "filter": {
            "param": "commSelect",
            "empty": true
          }
        },
        {
          "filter": {
            "param": "brush",
            "empty": true
          }
        }
      ],
      "params": [
        {
          "name": "timeBrush",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ],
            "clear": "dblclick",
            "on": "[pointerdown, window:pointerup] > window:pointermove{150}",
            "translate": false,
            "zoom": false
          }
        }
      ],
      "mark": {
        "type": "line",
        "point": {
          "size": 30
        },
        "strokeWidth": 2.5,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "transaction_date",
          "timeUnit": "yearquarter",
          "type": "temporal",
          "title": "Quarter",
          "axis": {
            "format": "%Y",
            "tickCount": "year"
          },
          "scale": {
            "domain": [
              "2015-01-01T00:00:00",
              "2026-08-01T00:00:00"
            ]
          }
        },
        "y": {
          "aggregate": "median",
          "field": "price_sqm",
          "type": "quantitative",
          "title": "Median AED/m²",
          "axis": {
            "format": ",.0f"
          },
          "scale": {
            "domainMin": 0,
            "domainMax": 30000,
            "nice": true
          }
        },
        "color": {
          "field": "reg_type_en",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Existing Properties",
              "Off-Plan Properties"
            ],
            "range": [
              "#2563eb",
              "#f97316"
            ]
          },
          "legend": {
            "orient": "top"
          }
        },
        "tooltip": [
          {
            "field": "transaction_date",
            "timeUnit": "yearquarter",
            "type": "temporal",
            "title": "Quarter",
            "format": "%Y Q%q"
          },
          {
            "field": "reg_type_en",
            "type": "nominal",
            "title": "Registration Type"
          },
          {
            "aggregate": "median",
            "field": "price_sqm",
            "type": "quantitative",
            "title": "Median AED/m²",
            "format": ",.0f"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Sales",
            "format": ","
          }
        ]
      }
    },
    {
      "hconcat": [
        {
          "title": {
            "text": "Price Distribution by Registration Type",
            "subtitle": "Box: Q1–Q3 | Median line | Whiskers: 1.5 × IQR | Outliers hidden"
          },
          "width": 420,
          "height": 300,
          "transform": [
            {
              "filter": {
                "param": "brush",
                "empty": true
              }
            },
            {
              "filter": {
                "param": "commSelect",
                "empty": true
              }
            },
            {
              "filter": {
                "param": "timeBrush",
                "empty": true
              }
            }
          ],
          "layer": [
            {
              "mark": {
                "type": "boxplot",
                "extent": 1.5,
                "outliers": false,
                "size": 80,
                "median": {
                  "color": "#111827",
                  "strokeWidth": 3
                }
              },
              "encoding": {
                "x": {
                  "field": "reg_type_en",
                  "type": "nominal",
                  "title": null,
                  "scale": {
                    "domain": [
                      "Existing Properties",
                      "Off-Plan Properties"
                    ]
                  },
                  "axis": {
                    "labelAngle": 0,
                    "labelLimit": 220
                  }
                },
                "y": {
                  "field": "price_sqm",
                  "type": "quantitative",
                  "title": "Price per m² (AED)",
                  "scale": {
                    "domain": [
                      0,
                      60000
                    ]
                  },
                  "axis": {
                    "format": ",.0f"
                  }
                },
                "color": {
                  "field": "reg_type_en",
                  "type": "nominal",
                  "legend": null,
                  "scale": {
                    "domain": [
                      "Existing Properties",
                      "Off-Plan Properties"
                    ],
                    "range": [
                      "#2563eb",
                      "#f97316"
                    ]
                  }
                }
              }
            },
            {
              "transform": [
                {
                  "aggregate": [
                    {
                      "op": "median",
                      "field": "price_sqm",
                      "as": "median_price"
                    }
                  ],
                  "groupby": [
                    "reg_type_en"
                  ]
                },
                {
                  "calculate": "datum.reg_type_en === 'Existing Properties' ? datum.median_price : null",
                  "as": "existing_value"
                },
                {
                  "calculate": "datum.reg_type_en === 'Off-Plan Properties' ? datum.median_price : null",
                  "as": "offplan_value"
                },
                {
                  "aggregate": [
                    {
                      "op": "max",
                      "field": "existing_value",
                      "as": "existing_median"
                    },
                    {
                      "op": "max",
                      "field": "offplan_value",
                      "as": "offplan_median"
                    }
                  ]
                },
                {
                  "calculate": "isValid(datum.existing_median) && isValid(datum.offplan_median) && datum.existing_median > 0 ? 100 * (datum.offplan_median - datum.existing_median) / datum.existing_median : null",
                  "as": "gap_pct"
                },
                {
                  "calculate": "isValid(datum.gap_pct) ? 'Off-Plan gap: ' + format(datum.gap_pct, '+.1f') + '%' : 'Both groups needed to compare'",
                  "as": "comparison_label"
                }
              ],
              "mark": {
                "type": "text",
                "align": "right",
                "baseline": "top",
                "fontSize": 13,
                "fontWeight": "bold",
                "color": "#263849"
              },
              "encoding": {
                "x": {
                  "value": {
                    "expr": "width - 12"
                  }
                },
                "y": {
                  "value": 18
                },
                "text": {
                  "field": "comparison_label",
                  "type": "nominal"
                }
              }
            }
          ]
        },
        {
          "title": {
            "text": "Median Price Heatmap by Size and Type",
            "subtitle": "100 m² size bands | Cells with fewer than 5 sales are hidden"
          },
          "width": 680,
          "height": 300,
          "transform": [
            {
              "filter": {
                "param": "brush",
                "empty": true
              }
            },
            {
              "filter": {
                "param": "commSelect",
                "empty": true
              }
            },
            {
              "filter": {
                "param": "timeBrush",
                "empty": true
              }
            },
            {
              "bin": {
                "step": 100,
                "extent": [
                  0,
                  1000
                ]
              },
              "field": "area_sqm",
              "as": [
                "area_start",
                "area_end"
              ]
            },
            {
              "aggregate": [
                {
                  "op": "median",
                  "field": "price_sqm",
                  "as": "median_price"
                },
                {
                  "op": "count",
                  "as": "transaction_count"
                }
              ],
              "groupby": [
                "property_type_en",
                "area_start",
                "area_end"
              ]
            },
            {
              "filter": "datum.transaction_count >= 5"
            }
          ],
          "mark": {
            "type": "rect",
            "stroke": "white",
            "strokeWidth": 3
          },
          "encoding": {
            "x": {
              "field": "area_start",
              "type": "quantitative",
              "title": "Property Area Range (m²)",
              "scale": {
                "domain": [
                  0,
                  1000
                ]
              }
            },
            "x2": {
              "field": "area_end"
            },
            "y": {
              "field": "property_type_en",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Unit",
                  "Villa"
                ]
              }
            },
            "color": {
              "field": "median_price",
              "type": "quantitative",
              "title": "Median AED/m²",
              "scale": {
                "type": "threshold",
                "domain": [
                  8000,
                  12000,
                  16000,
                  22000,
                  35000
                ],
                "range": [
                  "#2CA58D",
                  "#6FCF97",
                  "#F2C94C",
                  "#F2994A",
                  "#EB5757",
                  "#8E44AD"
                ]
              },
              "legend": {
                "orient": "bottom",
                "format": ",.0f",
                "direction": "horizontal"
              }
            },
            "tooltip": [
              {
                "field": "property_type_en",
                "type": "nominal",
                "title": "Property Type"
              },
              {
                "field": "area_start",
                "type": "quantitative",
                "title": "Area From (m²)",
                "format": ",.0f"
              },
              {
                "field": "area_end",
                "type": "quantitative",
                "title": "Area To (m²)",
                "format": ",.0f"
              },
              {
                "field": "transaction_count",
                "type": "quantitative",
                "title": "Sales",
                "format": ","
              },
              {
                "field": "median_price",
                "type": "quantitative",
                "title": "Median AED/m²",
                "format": ",.0f"
              }
            ]
          }
        }
      ],
      "spacing": 26
    }
  ],
  "spacing": 40,
  "resolve": {
    "scale": {
      "color": "independent"
    },
    "legend": {
      "color": "independent"
    }
  },
  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "concat": {
      "spacing": 50
    },
    "axis": {
      "labelFontSize": 13,
      "titleFontSize": 15,
      "gridColor": "#e5e7eb",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 13,
      "titleFontSize": 13
    },
    "title": {
      "fontSize": 18,
      "subtitleFontSize": 13,
      "color": "#1f2937",
      "anchor": "start"
    }
  }
}
